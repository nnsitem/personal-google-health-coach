# Copy to .env and fill in. Never commit .env.

# --- LINE Messaging API (LINE Developers console > your channel) ---
LINE_CHANNEL_SECRET=           # Channel secret (Basic settings tab)
LINE_CHANNEL_ACCESS_TOKEN=     # Long-lived token (Messaging API tab > issue)
LINE_USER_ID=                  # Your own user ID — used as ADMIN_LINE_USER_ID for
                                # coach.watchdog's auto-restart notifications (not
                                # per-user identity, which is now DB-backed in v2)

# --- Cloudflare Tunnel (only needed once webhook goes live) ---
CLOUDFLARE_TUNNEL_TOKEN=

# --- Gemini (Google AI) ---
GEMINI_API_KEY=

# --- Local testing ---
# Enables POST /chat (which is publicly reachable through the tunnel!) when set;
# requests must send the same value in an X-Chat-Token header. Leave empty to
# keep the endpoint disabled.
CHAT_TEST_TOKEN=

# --- General ---
TZ=Asia/Bangkok

# Seconds to wait after a food photo (or a caption sent right after) before
# analyzing — lets multiple photos / a trailing caption merge into one log.
# Default 3.5 if unset.
PHOTO_BATCH_WINDOW_SECONDS=
